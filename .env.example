# Schwab Trader API (Accounts and Trading) — set these as Netlify environment variables.
# Never commit real values. The App Key/Secret come from your app on developer.schwab.com.
SCHWAB_APP_KEY=your_app_key
SCHWAB_APP_SECRET=your_app_secret

# Must EXACTLY match the Callback URL registered on your Schwab app.
# After first deploy, this is: https://YOUR-SITE.netlify.app/.netlify/functions/schwab-callback
SCHWAB_CALLBACK_URL=https://YOUR-SITE.netlify.app/.netlify/functions/schwab-callback

# Exact public origin used to reject cross-site order requests (no trailing slash).
APP_URL=https://YOUR-SITE.netlify.app

# Live orders fail closed unless this is exactly "true". Leave false through testing.
SCHWAB_ORDER_PLACEMENT_ENABLED=false

# Pin Node 20+ for the Vite 8 build.
NODE_VERSION=22
